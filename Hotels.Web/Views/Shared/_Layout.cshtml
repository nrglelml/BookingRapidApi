<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StayFinder</title>
    <meta name="description" content="Dünyanın dört bir yanındaki otelleri karşılaştır, sana en uygun konaklamayı kolayca bul.">

    <!-- Google Fonts: Manrope -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Özel stiller -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Header -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand" href="#">
                    <span class="brand-mark"><i class="bi bi-geo-alt-fill"></i></span>
                    <span class="brand-text">Stay<span>Finder</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto me-lg-4 main-menu">
                        <li class="nav-item"><a class="nav-link active" aria-current="page" asp-action="Index" asp-controller="Home">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Oteller</a></li>
                        <li class="nav-item"><a class="nav-link" href="#destinations">Popüler Şehirler</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Hakkımızda</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">İletişim</a></li>
                    </ul>

                    <div class="nav-actions">
                        <button type="button" class="currency-pill" aria-label="Para birimi: TL">
                            <i class="bi bi-currency-tl"></i> TL
                        </button>
                        <a href="#" class="account-btn" aria-label="Hesabım">
                            <i class="bi bi-person"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @RenderBody()

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-12 col-md-6">
                    <a class="brand footer-brand" href="#">
                        <span class="brand-mark"><i class="bi bi-geo-alt-fill"></i></span>
                        <span class="brand-text">Stay<span>Finder</span></span>
                    </a>
                    <p class="footer-text">Bir sonraki konaklaman için doğru oteli keşfet.</p>
                </div>
                <div class="col-12 col-md-6">
                    <ul class="footer-links list-unstyled">
                        <li><a href="#">Ana Sayfa</a></li>
                        <li><a href="#">Oteller</a></li>
                        <li><a href="#">Hakkımızda</a></li>
                        <li><a href="#">İletişim</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <span>© 2026 StayFinder. Tüm hakları saklıdır.</span>
                <div class="footer-social">
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS (navbar toggle için) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>
